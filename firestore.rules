rules_version = '2';
service cloud.firestore {

  // Determine if the value of the field "key" is the same
  // before and after the request.
  function unchanged(key) {
    return (key in resource.data)
      && (key in request.resource.data)
      && (resource.data[key] == request.resource.data[key]);
  }

  match /databases/{database}/documents {
    // Tools:
    //   - Anyone can read (public access for browsing)
    //   - No create/update allowed for regular users (admin only)
    //   - Deletes are not allowed (default)
    match /tools/{toolId} {
      allow read;
      
      // Reviews:
      //   - Anyone can read (public access for browsing)
      //   - Authenticated user can create if userId matches
      //   - Deletes and updates are not allowed (default)
      match /reviews/{reviewId} {
        // Reviews remain public so that anyone can read them
        allow read;
        
        // Allow creation only if the user is authenticated and writes using their own verified user ID
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid;
      }
    }

    // User favorites:
    //   - Only owner can read/write
    match /users/{userId}/favorites/{toolId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
